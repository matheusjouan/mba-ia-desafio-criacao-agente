# --- Gemini (padrão, exigido pelo desafio) ---
# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Usa a API do AI Studio, não a Vertex AI (FALSE)
GOOGLE_GENAI_USE_VERTEXAI=
# Modelo Gemini usado pelos agentes (vazio = gemini-2.5-flash)
AURORA_MODELO=

# --- Alternativa opcional: Claude (usada só se GOOGLE_API_KEY estiver vazia) ---
# Chave da Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Modelo Claude usado pelos agentes (vazio = claude-haiku-5-5)
AURORA_MODELO_ANTHROPIC=
